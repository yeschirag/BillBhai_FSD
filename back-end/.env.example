# BillBhai backend environment template.
# Copy to back-end/.env and fill in real values. Never commit the real file.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string.
# Local dev (Homebrew postgres): postgresql://<user>:<password>@localhost:5432/billbhai
# Managed providers (Render/Neon/Supabase) provide this same variable; append
# ?sslmode=require or set PGSSL=require when the provider enforces TLS.
DATABASE_URL=postgresql://billbhai_app:CHANGE_ME@localhost:5432/billbhai

# Integration tests run against this database (see npm test).
TEST_DATABASE_URL=postgresql://billbhai_app:CHANGE_ME@localhost:5432/billbhai_test

# Set a long random value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production

# Pool size for the backend process (leave default unless tuning).
DB_POOL_MAX=10

# Set to "require" when your PostgreSQL provider enforces TLS.
PGSSL=
